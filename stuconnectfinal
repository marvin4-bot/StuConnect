def sterne_text(n):
    return "★" * n + "☆" * (5 - n)

def erkenne_uni(email):
    e = email.lower().strip()
    if e.endswith("@hm.edu"):          return "Hochschule München (HM)"
    elif e.endswith("@campus.lmu.de"): return "Ludwig-Maximilians-Universität (LMU)"
    elif e.endswith("@mytum.de"):      return "Technische Universität München (TUM)"
    else:                              return ""

def name_aus_email(email):
    try:
        local = email.split("@")[0]
        return " ".join(t.capitalize() for t in local.split("."))
    except:
        return ""

