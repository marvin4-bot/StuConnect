def erstelle_nav(eltern, aktiv):
    tk.Frame(eltern, bg=GRAU_BG, height=1).pack(side="bottom", fill="x")
    nav = tk.Frame(eltern, bg=WEISS)
    nav.pack(side="bottom", fill="x", pady=6)
    for sym, name, fn in [("🏠","Home",zu_home),("🔍","Suche",zu_suche),("💬","Chat",zu_chat),("👤","Profil",zu_profil)]:
        farbe = LILA if name == aktiv else GRAU_TEXT
        bf = tk.Frame(nav, bg=WEISS)
        bf.pack(side="left", expand=True)
        tk.Button(bf, text=sym+chr(10)+name, command=fn,
                  bg=WEISS, fg=farbe, font=("Helvetica", 9),
                  relief="flat", bd=0, cursor="hand2").pack(expand=True)

