def filtere_angebote():
    suchtext = such_entry.get().strip().lower()
    if suchtext == "🔍  fach oder name suchen": suchtext = ""
    fach   = fach_filter_var.get()
    region = region_filter_var.get()
    preis_g = preis_filter_var.get()
    gesch  = gesch_filter_var.get()
    ergebnis = []
    for a in beispiel_angebote:
        if suchtext and suchtext not in a["fach"].lower() and suchtext not in a["name"].lower():
            continue
        if fach != "Alle Fächer" and a["fach"] != fach:
            continue
        if region != "Alle":
            if region == "Online"  and a["unterricht"] not in ["Online","Beides"]: continue
            if region == "Vor Ort" and a["unterricht"] not in ["Vor Ort","Beides"]: continue
        if preis_g != "Alle":
            try:
                max_p = int(preis_g.replace("bis ","").replace(" €",""))
                if int(a["preis"]) > max_p: continue
            except: pass
        if gesch != "Alle":
            if geschlecht_aus_name(a["name"]) != gesch: continue
        ergebnis.append(a)
    return ergebnis

